// SPDX-License-Identifier: MIT
// Totem 38-key split — standalone Miryoku-style keymap
// Customizations vs stock Miryoku:
//   • Home row mods: balanced flavor, 300 ms tapping term, 150 ms require-prior-idle
//   • Right home row col 5 (position 19): semicolon (was quote)
//   • Left outer pinky  (position 20): caps_word toggle
//   • Right outer pinky (position 31): single quote
//   • NAV layer home row: vim arrows (H=←  J=↓  K=↑  L=→)
//
// 38-key binding order (matches totem_dongle.overlay matrix transform):
//   0-9  : top  row   Q  W  E  R  T  |  Y  U  I  O  P
//  10-19  : home row  A  S  D  F  G  |  H  J  K  L  ;
//     20  : left outer pinky
//  21-30  : bottom    Z  X  C  V  B  |  N  M  ,  .  /
//     31  : right outer pinky
//  32-34  : left  thumbs  ESC  SPC  TAB
//  35-37  : right thumbs  ENT  BSPC DEL

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define MSE  2
#define MED  3
#define NUM  4
#define SYM  5
#define FUN  6

/ {
    behaviors {
        // Home-row mod: balanced flavor so holding after a fast tap resolves to
        // the tap keysym rather than the modifier.  require-prior-idle-ms keeps
        // the mod from firing mid-burst (fixes the accidental LGUI+S / Save-As).
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ── 0: BASE ──────────────────────────────────────────────────────────
        base_layer {
            display-name = "BASE";
            bindings = <
// ╭────────────┬────────────┬────────────┬────────────┬────────────╮   ╭────────────┬────────────┬────────────┬────────────┬────────────╮
    &kp Q        &kp W        &kp E        &kp R        &kp T             &kp Y        &kp U        &kp I        &kp O        &kp P
// ├────────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
    &hm LGUI A   &hm LALT S   &hm LCTRL D  &hm LSFT F   &kp G             &kp H        &hm RSFT J   &hm RCTRL K  &hm RALT L   &hm RGUI SEMI
// ├────────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
    &caps_word
    &kp Z        &kp X        &kp C        &kp V        &kp B             &kp N        &kp M        &kp COMMA    &kp DOT      &kp FSLH
                                                                                                                               &kp SQT
// ╰────────────┴────────────┴────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┴────────────┴────────────╯
                              &lt MED ESC  &lt NAV SPACE &lt MSE TAB       &lt SYM RET  &lt NUM BSPC &lt FUN DEL
//                            ╰────────────┴────────────┴────────────╯   ╰────────────┴────────────┴────────────╯
            >;
        };

        // ── 1: NAV ───────────────────────────────────────────────────────────
        // Activated by: hold SPC (left middle thumb)
        // Right hand: vim arrows on home row, clipboard on top, page nav on bottom
        // Left hand: bare modifiers for shift-select, ctrl-arrow word-jump, etc.
        nav_layer {
            display-name = "NAV";
            bindings = <
// ╭────────────┬────────────┬────────────┬────────────┬────────────╮   ╭────────────┬────────────┬────────────┬────────────┬────────────╮
    &none        &none        &none        &none        &none             &kp LC(Y)    &kp LC(V)    &kp LC(C)    &kp LC(X)    &kp LC(Z)
// ├────────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
    &kp LGUI     &kp LALT     &kp LCTRL    &kp LSFT     &none             &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT    &kp DEL
// ├────────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
    &none
    &none        &none        &none        &none        &none             &kp HOME     &kp PG_DN    &kp PG_UP    &kp END      &kp INS
                                                                                                                               &none
// ╰────────────┴────────────┴────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┴────────────┴────────────╯
                              &none        &trans        &none             &kp RET      &kp BSPC     &kp DEL
//                            ╰────────────┴────────────┴────────────╯   ╰────────────┴────────────┴────────────╯
            >;
        };

        // ── 2: MOUSE ─────────────────────────────────────────────────────────
        // Activated by: hold TAB (left ring thumb)
        // Right hand: mouse cursor on home row, scroll wheel on bottom row
        mouse_layer {
            display-name = "MOUSE";
            bindings = <
// ╭────────────┬────────────┬────────────┬────────────┬────────────╮   ╭────────────┬────────────┬────────────┬────────────┬────────────╮
    &none        &none        &none        &none        &none             &kp LC(Y)    &kp LC(V)    &kp LC(C)    &kp LC(X)    &kp LC(Z)
// ├────────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
    &kp LGUI     &kp LALT     &kp LCTRL    &kp LSFT     &none             &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &none
// ├────────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
    &none
    &none        &none        &none        &none        &none             &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT &none
                                                                                                                               &none
// ╰────────────┴────────────┴────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┴────────────┴────────────╯
                              &none        &none         &trans            &mkp MCLK    &mkp LCLK    &mkp RCLK
//                            ╰────────────┴────────────┴────────────╯   ╰────────────┴────────────┴────────────╯
            >;
        };

        // ── 3: MEDIA ─────────────────────────────────────────────────────────
        // Activated by: hold ESC (left index thumb)
        // Right hand: media controls; Bluetooth / USB output selection on bottom
        media_layer {
            display-name = "MEDIA";
            bindings = <
// ╭────────────┬────────────┬────────────┬────────────┬────────────╮   ╭────────────┬────────────┬────────────┬────────────┬────────────╮
    &none        &none        &none        &none        &none             &none        &none        &none        &none        &none
// ├────────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
    &kp LGUI     &kp LALT     &kp LCTRL    &kp LSFT     &none             &out OUT_TOG &kp C_PREV   &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT
// ├────────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
    &none
    &none        &none        &none        &none        &none             &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3
                                                                                                                               &none
// ╰────────────┴────────────┴────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┴────────────┴────────────╯
                              &trans        &none        &none             &kp C_STOP   &kp C_PP     &kp C_MUTE
//                            ╰────────────┴────────────┴────────────╯   ╰────────────┴────────────┴────────────╯
            >;
        };

        // ── 4: NUM ───────────────────────────────────────────────────────────
        // Activated by: hold BSPC (right middle thumb)
        // Left hand: numpad layout + brackets; right hand: mirror mods
        num_layer {
            display-name = "NUM";
            bindings = <
// ╭────────────┬────────────┬────────────┬────────────┬────────────╮   ╭────────────┬────────────┬────────────┬────────────┬────────────╮
    &kp LBKT     &kp N7       &kp N8       &kp N9       &kp RBKT          &none        &none        &none        &none        &none
// ├────────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
    &kp SEMI     &kp N4       &kp N5       &kp N6       &kp EQUAL         &none        &kp RSFT     &kp RCTRL    &kp RALT     &kp RGUI
// ├────────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
    &none
    &kp GRAVE    &kp N1       &kp N2       &kp N3       &kp BSLH          &none        &none        &none        &none        &none
                                                                                                                               &none
// ╰────────────┴────────────┴────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┴────────────┴────────────╯
                              &kp DOT      &kp N0        &kp MINUS         &none        &trans       &none
//                            ╰────────────┴────────────┴────────────╯   ╰────────────┴────────────┴────────────╯
            >;
        };

        // ── 5: SYM ───────────────────────────────────────────────────────────
        // Activated by: hold ENT (right index thumb)
        // Left hand: shifted symbol versions of the NUM layer
        sym_layer {
            display-name = "SYM";
            bindings = <
// ╭────────────┬────────────┬────────────┬────────────┬────────────╮   ╭────────────┬────────────┬────────────┬────────────┬────────────╮
    &kp LBRC     &kp AMPS     &kp STAR     &kp LPAR     &kp RBRC          &none        &none        &none        &none        &none
// ├────────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
    &kp COLN     &kp DLLR     &kp PRCNT    &kp CARET    &kp PLUS          &none        &kp RSFT     &kp RCTRL    &kp RALT     &kp RGUI
// ├────────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
    &none
    &kp TILDE    &kp EXCL     &kp AT       &kp HASH     &kp PIPE          &none        &none        &none        &none        &none
                                                                                                                               &none
// ╰────────────┴────────────┴────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┴────────────┴────────────╯
                              &kp LPAR     &kp RPAR      &kp UNDER         &trans       &none        &none
//                            ╰────────────┴────────────┴────────────╯   ╰────────────┴────────────┴────────────╯
            >;
        };

        // ── 6: FUN ───────────────────────────────────────────────────────────
        // Activated by: hold DEL (right pinky thumb)
        // Left hand: function keys in numpad layout
        fun_layer {
            display-name = "FUN";
            bindings = <
// ╭────────────┬────────────┬────────────┬────────────┬────────────╮   ╭────────────┬────────────┬────────────┬────────────┬────────────╮
    &kp F12      &kp F7       &kp F8       &kp F9       &kp PSCRN         &none        &none        &none        &none        &none
// ├────────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
    &kp F11      &kp F4       &kp F5       &kp F6       &kp SLCK          &none        &kp RSFT     &kp RCTRL    &kp RALT     &kp RGUI
// ├────────────┼────────────┼────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┤
    &none
    &kp F10      &kp F1       &kp F2       &kp F3       &kp PAUSE_BREAK   &none        &none        &none        &none        &none
                                                                                                                               &none
// ╰────────────┴────────────┴────────────┼────────────┼────────────┤   ├────────────┼────────────┼────────────┴────────────┴────────────╯
                              &kp K_APP    &kp SPACE     &kp TAB           &none        &none        &trans
//                            ╰────────────┴────────────┴────────────╯   ╰────────────┴────────────┴────────────╯
            >;
        };
    };
};
